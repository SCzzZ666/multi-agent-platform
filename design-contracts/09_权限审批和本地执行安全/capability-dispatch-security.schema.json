{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-native.local/security/capability-dispatch/1.0/schema.json",
  "title": "Capability Dispatch Security Records 1.0",
  "description": "Internal security facts for authorization, approval consumption, invocation, receipt and reconciliation. This is not a public API approval schema.",
  "oneOf": [
    {
      "$ref": "#/$defs/actionBinding"
    },
    {
      "$ref": "#/$defs/authorizationDecision"
    },
    {
      "$ref": "#/$defs/approvalConsumption"
    },
    {
      "$ref": "#/$defs/invocationIntent"
    },
    {
      "$ref": "#/$defs/invocationReceipt"
    },
    {
      "$ref": "#/$defs/reconciliationRecord"
    }
  ],
  "$defs": {
    "uuidv7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "riskLevel": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "dispatchApprovalKind": {
      "enum": [
        "CAPABILITY",
        "PATCH_APPLY"
      ]
    },
    "diagnosticCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
    },
    "credentialRef": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9_.:/-]{0,255}$"
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "artifactPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "version"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "actionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "binding_version",
        "action_binding_id",
        "project_id",
        "run_id",
        "workflow_version_id",
        "run_plan_version_id",
        "node_attempt_id",
        "action_id",
        "tool_key",
        "capability_key",
        "tool_schema_digest",
        "normalized_args",
        "resource_scopes",
        "risk_level",
        "credential_refs",
        "canonicalization",
        "args_digest",
        "resource_scope_digest",
        "action_digest",
        "created_at"
      ],
      "properties": {
        "record_type": {
          "const": "ACTION_BINDING"
        },
        "binding_version": {
          "const": "1.0"
        },
        "action_binding_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "project_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "run_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "workflow_version_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "run_plan_version_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "node_attempt_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "action_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "tool_key": {
          "$ref": "#/$defs/key"
        },
        "capability_key": {
          "$ref": "#/$defs/key"
        },
        "tool_schema_digest": {
          "$ref": "#/$defs/digest"
        },
        "normalized_args": {
          "$ref": "#/$defs/jsonObject"
        },
        "resource_scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://schemas.ai-native.local/security/resource-scope/1.0/schema.json"
          }
        },
        "risk_level": {
          "$ref": "#/$defs/riskLevel"
        },
        "credential_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/credentialRef"
          }
        },
        "canonicalization": {
          "const": "RFC8785"
        },
        "args_digest": {
          "$ref": "#/$defs/digest"
        },
        "resource_scope_digest": {
          "$ref": "#/$defs/digest"
        },
        "action_digest": {
          "$ref": "#/$defs/digest"
        },
        "created_at": {
          "$ref": "#/$defs/dateTime"
        }
      }
    },
    "authorizationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "authorization_decision_id",
        "action_binding_id",
        "action_digest",
        "effect",
        "policy_version",
        "intersection_digest",
        "reason_codes",
        "evaluated_at"
      ],
      "properties": {
        "record_type": {
          "const": "AUTHORIZATION_DECISION"
        },
        "authorization_decision_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "action_binding_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "action_digest": {
          "$ref": "#/$defs/digest"
        },
        "effect": {
          "enum": [
            "ALLOW",
            "DENY",
            "APPROVAL_REQUIRED"
          ]
        },
        "required_approval_kind": {
          "$ref": "#/$defs/dispatchApprovalKind"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "intersection_digest": {
          "$ref": "#/$defs/digest"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/diagnosticCode"
          }
        },
        "evaluated_at": {
          "$ref": "#/$defs/dateTime"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "effect": {
                "const": "APPROVAL_REQUIRED"
              }
            },
            "required": [
              "effect"
            ]
          },
          "then": {
            "required": [
              "required_approval_kind"
            ]
          },
          "else": {
            "not": {
              "required": [
                "required_approval_kind"
              ]
            }
          }
        }
      ]
    },
    "approvalConsumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "approval_consumption_id",
        "approval_kind",
        "approval_request_id",
        "approval_decision_id",
        "action_binding_id",
        "action_digest",
        "intent_id",
        "consumed_uses",
        "remaining_uses",
        "consumed_at"
      ],
      "properties": {
        "record_type": {
          "const": "APPROVAL_CONSUMPTION"
        },
        "approval_consumption_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "approval_kind": {
          "$ref": "#/$defs/dispatchApprovalKind"
        },
        "approval_request_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "approval_decision_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "action_binding_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "action_digest": {
          "$ref": "#/$defs/digest"
        },
        "intent_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "consumed_uses": {
          "const": 1
        },
        "remaining_uses": {
          "type": "integer",
          "minimum": 0
        },
        "consumed_at": {
          "$ref": "#/$defs/dateTime"
        }
      }
    },
    "invocationIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "intent_version",
        "intent_id",
        "action_binding_id",
        "action_digest",
        "authorization_decision_id",
        "idempotency_class",
        "status",
        "fencing_token",
        "created_at"
      ],
      "properties": {
        "record_type": {
          "const": "INVOCATION_INTENT"
        },
        "intent_version": {
          "const": "1.0"
        },
        "intent_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "action_binding_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "action_digest": {
          "$ref": "#/$defs/digest"
        },
        "authorization_decision_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "approval_consumption_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "idempotency_class": {
          "enum": [
            "READ_ONLY",
            "IDEMPOTENT",
            "NON_IDEMPOTENT"
          ]
        },
        "provider_idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "enum": [
            "INTENT_RECORDED",
            "DISPATCHING",
            "SUCCEEDED",
            "FAILED",
            "UNKNOWN",
            "NOT_DISPATCHED"
          ]
        },
        "not_dispatched_reason": {
          "$ref": "#/$defs/diagnosticCode"
        },
        "fencing_token": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "$ref": "#/$defs/dateTime"
        },
        "updated_at": {
          "$ref": "#/$defs/dateTime"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_DISPATCHED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "not_dispatched_reason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "not_dispatched_reason"
              ]
            }
          }
        }
      ]
    },
    "invocationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "receipt_id",
        "intent_id",
        "outcome",
        "received_at"
      ],
      "properties": {
        "record_type": {
          "const": "INVOCATION_RECEIPT"
        },
        "receipt_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "intent_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "outcome": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "UNKNOWN"
          ]
        },
        "provider_operation_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "result_digest": {
          "$ref": "#/$defs/digest"
        },
        "diagnostic_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/diagnosticCode"
          }
        },
        "received_at": {
          "$ref": "#/$defs/dateTime"
        }
      }
    },
    "reconciliationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "reconciliation_id",
        "intent_id",
        "prior_outcome",
        "result",
        "method",
        "evidence_artifacts",
        "reconciled_at"
      ],
      "properties": {
        "record_type": {
          "const": "RECONCILIATION_RECORD"
        },
        "reconciliation_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "intent_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "prior_outcome": {
          "const": "UNKNOWN"
        },
        "result": {
          "enum": [
            "RECONCILED_SUCCEEDED",
            "RECONCILED_FAILED",
            "RECOVERY_REQUIRED"
          ]
        },
        "method": {
          "enum": [
            "PROVIDER_QUERY",
            "IDEMPOTENCY_LOOKUP",
            "SEMANTIC_EVIDENCE",
            "HUMAN_DECISION"
          ]
        },
        "evidence_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactPointer"
          }
        },
        "reconciled_by": {
          "$ref": "#/$defs/uuidv7"
        },
        "result_digest": {
          "$ref": "#/$defs/digest"
        },
        "reconciled_at": {
          "$ref": "#/$defs/dateTime"
        }
      }
    }
  }
}
