# 占位符配置 —— 不含任何真实值（CODEBASE-BL §13.3）。
# 真实 .env 不入库（.gitignore 已排除）；项目根的 .env 由 bootstrap/config.py 装载，正文只经 credential_ref 进入应用。

# PostgreSQL（platform schema；迁移/API/Worker 三账户分离，见 README §5 建账户步骤）
DATABASE_URL=postgresql+psycopg://api_user:CHANGE_ME@localhost:5432/ai_native
MIGRATION_DATABASE_URL=postgresql+psycopg://migrator:CHANGE_ME@localhost:5432/ai_native
WORKER_DATABASE_URL=postgresql+psycopg://worker_user:CHANGE_ME@localhost:5432/ai_native

# ArtifactStore（本地内容寻址适配器首发，正文不入库）
ARTIFACT_STORE_DIR=.data/artifacts

# 模型供应商 —— 三家 OpenAI 兼容端点（开发期填本地 .env；秘密正文不入库）
DASHSCOPE_API_KEY=sk-CHANGE_ME
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=sk-CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
KIMI_API_KEY=sk-CHANGE_ME
KIMI_BASE_URL=https://api.moonshot.cn/v1

# 运行 Profile（production 必须拒绝测试身份/宽松 CORS/任意 Runner Profile/未配对 Host Bridge）
AI_NATIVE_ENV=development
APP_PROFILE=development